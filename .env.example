# Ejemplo de `.env` raíz (no subir credenciales reales)
# Variables usadas por el backend (FastAPI)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-publica"

# Opcional: si tienes una service role key, usar únicamente en backend
# SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-secreta"
